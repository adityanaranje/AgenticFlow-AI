# ============================================================
# AgentFlow AI - environment variables (root)
#
# Copy this file to `.env` for docker-compose, or split its values
# into `backend/.env` and `frontend/.env.local` for bare-metal
# development. Never commit real `.env` files.
#
# Browser-safety rules (never violated):
#   - NEXT_PUBLIC_* values are inlined into the browser bundle.
#     Only public values belong there.
#   - SUPABASE_SERVICE_ROLE_KEY, LANGFUSE_SECRET_KEY and
#     QDRANT_API_KEY are BACKEND-ONLY and must never be prefixed
#     NEXT_PUBLIC_ or referenced by frontend code.
# ============================================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=AgentFlow AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- OpenAI (BACKEND-ONLY) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ---
# SUPABASE_ANON_KEY holds the browser-safe key: Supabase's current
# "publishable" key (sb_publishable_...) or the legacy "anon" JWT.
# SUPABASE_SERVICE_ROLE_KEY holds the backend-only "secret" key
# (sb_secret_...). The names below are what backend/app/core/config.py
# reads; do not move the secret key into a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# BACKEND-ONLY - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Qdrant (BACKEND-ONLY key) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentflow_documents

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- Langfuse (BACKEND-ONLY secret) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Research throughput (optional; see backend/.env.example) ---
# OPENAI_TIMEOUT_SECONDS=60
# RETRIEVAL_CONCURRENCY=4
# EVIDENCE_BATCH_CHARS=60000
# EVIDENCE_MAX_CHUNKS=48
# RESEARCH_WORKER_CONCURRENCY=2
# No worker consuming the queue? run scripts/dev-workers.sh (or set 0 to disable).
# RESEARCH_UNCLAIMED_FALLBACK_SECONDS=15
#
# --- Ingestion throughput (optional; see backend/.env.example) ---
# Remote calls dominate upload/chunking time, so ingestion batches and
# parallelises them. Defaults are sane; tune when a provider rate-limits you
# or when a worker needs to drain a bigger queue.
# EMBEDDING_BATCH_SIZE=256
# EMBEDDING_CONCURRENCY=4
# CHUNK_INSERT_BATCH_SIZE=200
# QDRANT_UPSERT_BATCH_SIZE=128
# DOCUMENT_WORKER_CONCURRENCY=4

# --- Frontend (browser-safe NEXT_PUBLIC_ subset) ---
# Inlined into the browser bundle by Next.js at build time. Public /
# anonymous Supabase credentials only.
#
# docker-compose passes these into the frontend image. Running
# `npm run dev` by hand instead? Next.js will NOT read this file -
# put the same values in frontend/.env.local and restart the dev
# server. `cd frontend && npm run doctor` verifies it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
