# ============================================================
# AgentFlow AI - Backend environment variables
#
# Copy this file to `backend/.env` (or repository root `.env`)
# and fill in real values. Never commit `.env` files.
#
# Secrets marked BACKEND-ONLY must never be referenced from the
# Next.js frontend or shipped to the browser.
# ============================================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=AgentFlow AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- OpenAI (BACKEND-ONLY) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# BACKEND-ONLY - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Qdrant (API key is BACKEND-ONLY) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentflow_documents

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- Langfuse (secret key is BACKEND-ONLY) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
