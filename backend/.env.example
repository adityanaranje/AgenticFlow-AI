# ============================================================
# AgentFlow AI - Backend environment variables
#
# Copy this file to `backend/.env` (or repository root `.env`)
# and fill in real values. Never commit `.env` files.
#
# Secrets marked BACKEND-ONLY must never be referenced from the
# Next.js frontend or shipped to the browser.
# ============================================================

# --- Application ---
ENVIRONMENT=development
APP_NAME=AgentFlow AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- OpenAI (BACKEND-ONLY) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# BACKEND-ONLY - never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Qdrant (API key is BACKEND-ONLY) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agentflow_documents

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# --- Document ingestion / RAG (Phase 4) ---
# Document worker job queue name.
DOCUMENT_JOB_QUEUE=agentflow:documents:jobs
# Storage bucket for uploaded files.
STORAGE_BUCKET=documents
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=25
# Vector dimension MUST match the embedding model you configure above.
# text-embedding-3-small = 1536 (the default).
EMBEDDING_DIMENSIONS=1536
# Chunking tuning (character based).
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Ingestion throughput (Phase 4) ---
# Ingestion is I/O bound (OpenAI, PostgREST, Qdrant): every knob below trades
# provider load for wall-clock time. Lower them if a provider rate-limits you.
#
# Chunk texts per OpenAI embedding request, requests in flight, and how many
# times a transient provider error (429/5xx/timeout) is retried with backoff.
EMBEDDING_BATCH_SIZE=256
EMBEDDING_CONCURRENCY=4
EMBEDDING_MAX_RETRIES=3
# Chunk rows per `document_chunks` insert, and batches in flight.
CHUNK_INSERT_BATCH_SIZE=200
CHUNK_INSERT_CONCURRENCY=2
# Vectors per Qdrant upsert request (Qdrant recommends <= 200), and requests
# in flight.
QDRANT_UPSERT_BATCH_SIZE=128
QDRANT_UPSERT_CONCURRENCY=2
# Documents processed in parallel per worker process. Raise it (and/or run
# more `document-worker` containers) when uploads queue up.
DOCUMENT_WORKER_CONCURRENCY=4
# Idle queue poll interval, in seconds (must stay below the Redis client's
# 3s socket timeout).
DOCUMENT_WORKER_POLL_SECONDS=2
# Threads used to process uploads when Redis is unavailable (dev fallback).
INLINE_PROCESSING_WORKERS=2

# --- Research / agents (Phase 5) ---
RESEARCH_JOB_QUEUE=agentflow:research:jobs
# Research throughput. A run is a chain of dependent model calls, so these
# control how much independent work runs at once and how tightly each
# provider call is bounded. Lower them if a provider rate-limits you.
#
# Per-request OpenAI timeout (seconds). The SDK default of 600s turns one
# stalled connection into a ten-minute wait.
OPENAI_TIMEOUT_SECONDS=60
# Retries for transient model errors (rate limits / timeouts / 5xx).
RESEARCH_LLM_MAX_RETRIES=2
# Queries retrieved in parallel (each: one embedding, one vector search).
RETRIEVAL_CONCURRENCY=4
# Evidence analysis: max characters of excerpts per model call, how many
# calls run at once, and the most chunks analysed per run.
EVIDENCE_BATCH_CHARS=60000
EVIDENCE_CONCURRENCY=4
EVIDENCE_MAX_CHUNKS=48
# Research runs processed in parallel per worker process.
RESEARCH_WORKER_CONCURRENCY=2
# Idle queue poll interval (seconds; stay below the Redis client's 3s timeout).
RESEARCH_WORKER_POLL_SECONDS=2
# Rows per report_sources insert.
REPORT_SOURCE_BATCH_SIZE=100
# TTL (seconds) for cached query embeddings (identical text -> identical vector).
EMBEDDING_CACHE_TTL_SECONDS=3600
# Max retrieval→gap retry loops per research run.
MAX_RESEARCH_ITERATIONS=3
# Optional research timeout, in seconds.
RESEARCH_TIMEOUT_SECONDS=600
# Default retrieval top-k per query during research.
RESEARCH_TOP_K=5

# --- Langfuse (secret key is BACKEND-ONLY) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
