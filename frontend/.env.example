# ============================================================
# AgentFlow AI - frontend environment variables
#
# Copy this file to `frontend/.env` or `frontend/.env.local` and fill in real values.
# Never commit `.env` / `.env.local` files.
#
#   cp frontend/.env.example frontend/.env.local          # bash / zsh
#   Copy-Item frontend/.env.example frontend/.env.local   # PowerShell
#
# Two things that trip people up:
#
#   1. Only `frontend/.env*` is read. The repository ROOT `.env` is used by
#      docker-compose and is invisible to `npm run dev`.
#   2. `NEXT_PUBLIC_*` values are inlined into the browser bundle when the dev
#      server starts. After editing this file you must restart `npm run dev`
#      (Turbopack prints "Reload env: .env.local" when it picked the change up)
#      or rebuild for `npm run build && npm run start`. `npm run doctor`
#      (in frontend/) checks all of this for you.
#
# WARNING: NEXT_PUBLIC_* values are inlined into the browser
# bundle. Only public/anonymous credentials belong here. Never add
# SUPABASE_SERVICE_ROLE_KEY, LANGFUSE_SECRET_KEY or QDRANT_API_KEY.
# ============================================================

# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
# (no path, no trailing slash). Supabase dashboard -> Project Settings ->
# General, or the "Connect" dialog.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase key. Supabase's current name for it is the
# PUBLISHABLE key ("sb_publishable_..."); the "anon" key is the legacy JWT
# equivalent that older projects still use. Either works - this file accepts
# both, and the publishable one wins if both are set.
#
# NEVER paste a secret key here (sb_secret_... or a service_role JWT):
# NEXT_PUBLIC_* values ship to every browser, a secret key bypasses Row Level
# Security, and Supabase answers HTTP 401 for secret keys used from a browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend (without the /api/v1 prefix).
# http://localhost:8000 for local dev / docker compose on the same
# machine.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------
# OPTIONAL — Google sign-in that shows YOUR domain, not the Supabase URL
# ------------------------------------------------------------------
# Leave this blank and "Continue with Google" uses the Supabase redirect
# flow: the browser passes through
# https://<project-ref>.supabase.co/auth/v1/authorize, so Google's account
# chooser reads "to continue to <project-ref>.supabase.co".
#
# Set it to your Google Cloud **Web application** client ID and the button
# switches to Google Identity Services: Google renders the prompt on this
# page, keyed to the Authorized JavaScript origin, so it reads
# "to continue to <your domain>" and the Supabase host never appears.
#
# This is public by design (it is in every Google sign-in page's HTML).
# Never put the client SECRET here - that belongs only in the Supabase
# dashboard.
#
# Also required, once per project:
#   Google Cloud -> Auth Platform -> Clients -> your Web client
#     Authorized JavaScript origins: http://localhost:3000 + your deployed origin
#   Supabase -> Authentication -> Sign In / Providers -> Google
#     "Client IDs": the same value as below (web client first if several)
#
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
